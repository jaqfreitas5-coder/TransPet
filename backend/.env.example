# Copie este arquivo para .env e ajuste se necessário
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transpet?schema=public"
PORT=3333
JWT_SECRET="troque-por-um-segredo-forte"

# Simulação da corrida (opcional)
SIMULACAO_AUTOMATICA=true       # false = status só avança pelo botão/rota /avancar
SIMULACAO_ETAPA_SEGUNDOS=10     # duração base de cada etapa
